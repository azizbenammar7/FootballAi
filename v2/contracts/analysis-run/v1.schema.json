{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footballai.local/contracts/analysis-run/v1.schema.json",
  "title": "FootballAi analysis run v1",
  "description": "Provenance, lifecycle, and isolated output references for one V2 analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "analysis_run_id",
    "status",
    "data_origin",
    "input",
    "code",
    "pipeline_version",
    "parameters",
    "models",
    "outputs",
    "created_at"
  ],
  "properties": {
    "contract_version": {
      "const": "footballai.analysis-run/v1"
    },
    "analysis_run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
    },
    "data_origin": {
      "enum": ["real", "synthetic"]
    },
    "input": {
      "$ref": "#/$defs/inputReference"
    },
    "code": {
      "$ref": "#/$defs/codeReference"
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelReference"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure": {
      "$ref": "#/$defs/failureDetail"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["started_at"]
            },
            {
              "required": ["completed_at"]
            },
            {
              "required": ["failure"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "required": ["started_at"],
        "properties": {
          "outputs": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["completed_at"]
            },
            {
              "required": ["failure"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "required": ["started_at", "completed_at"],
        "properties": {
          "outputs": {
            "minItems": 1
          }
        },
        "not": {
          "required": ["failure"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": ["started_at", "completed_at", "failure"],
        "properties": {
          "outputs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "required": ["completed_at"],
        "properties": {
          "outputs": {
            "maxItems": 0
          }
        },
        "not": {
          "required": ["failure"]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "codeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "dirty"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "modelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "relative_path",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "pattern": "^artifacts/(?!\\.{1,2}(?:/|$))[^/\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\]+)*$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
