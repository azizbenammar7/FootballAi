# ─────────────────────────────────────────────────────────────
# Video & large raw media  (never commit — multi-GB, licensed)
# ─────────────────────────────────────────────────────────────
data/raw/
videos/
*.mp4
*.webm
*.avi
*.mkv
*.mov

# ─────────────────────────────────────────────────────────────
# YOLOv8 model weights  (auto-downloaded by ultralytics on first run)
# ─────────────────────────────────────────────────────────────
*.pt
*.onnx

# ─────────────────────────────────────────────────────────────
# Processed pipeline outputs
#   - raw_tracks.parquet is a large intermediate (regenerated by 01_track.py)
#   - the small precomputed files BELOW are kept so the dashboard runs
#     immediately after cloning (see the ! un-ignore rules)
# ─────────────────────────────────────────────────────────────
data/processed/raw_tracks.parquet
data/processed/raw_tracks_checkpoint.csv

# Keep the lightweight precomputed data that powers the dashboard
!data/processed/meta.json
!data/processed/player_stats.parquet
!data/processed/player_summary.json
!data/processed/risk_scores.json

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.env
.venv*
venv/
env/
*.egg-info/

# ─────────────────────────────────────────────────────────────
# Editor / OS / tooling
# ─────────────────────────────────────────────────────────────
.DS_Store
.cursor/
.idea/
.vscode/
TechincalTest_Statement.rtf
